# Google OAuth browser client ID. Configure authorized JavaScript origins.
VITE_GOOGLE_AUTH_CLIENT_ID=replace-with-browser-client-id

# WARNING: Vite exposes all VITE_* values in the browser bundle.
# Do not put a privileged Gemini secret here for production.
# Move Gemini generation behind a server-side endpoint and keep its key server-only.
VITE_GOOGLE_GEMINI_AI_API_KEY=replace-with-restricted-development-key

# Browser-facing Places key, if the active autocomplete integration requires it.
# Restrict by HTTP referrer and enabled Google Maps Platform APIs.
VITE_GOOGLE_PLACES_API_KEY=replace-with-restricted-browser-key
